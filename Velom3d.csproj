<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Tests xUnit (projet séparé) et plugin Android : hors de l'assembly du jeu. -->
    <Compile Remove="UnitTests/**" />
    <Compile Remove="android-plugin/**" />
    <!-- Serveur de synchronisation : programme à part, voir Server/README.md. -->
    <Compile Remove="Server/**" />
    <!-- Programme d'aide Bluetooth de Windows : programme à part, voir Desktop/BleHelper/README.md. -->
    <Compile Remove="Desktop/**" />
  </ItemGroup>
</Project>
