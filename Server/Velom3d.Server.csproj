<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Serveur de synchronisation auto-hébergeable (voir README.md). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Velom3d.Server</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Messages échangés avec l'appli : le même fichier des deux côtés. -->
    <Compile Include="../Sync/Core/SyncProtocol.cs" Link="Shared/SyncProtocol.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>
</Project>
