{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Velom3d": {
    "Database": "data/velom3d.db",
    "AllowRegistration": true,
    "AuthRequestsPerMinute": 20,
    "MaxFailedLogins": 5,
    "LockoutMaxMinutes": 60,
    "SessionDays": 90,
    "TrustProxy": false,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Ssl": true,
      "User": "",
      "Password": "",
      "From": "",
      "ServerName": "Velom3d"
    }
  }
}
