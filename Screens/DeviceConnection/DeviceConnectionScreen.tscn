[gd_scene format=3]

[ext_resource type="Script" path="res://Screens/DeviceConnection/DeviceConnectionScreen.cs" id="1"]
[ext_resource type="PackedScene" path="res://Screens/DeviceConnection/DeviceRow.tscn" id="2"]
[ext_resource type="PackedScene" path="res://Screens/Common/Background.tscn" id="bg"]

[node name="DeviceConnectionScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")
RowScene = ExtResource("2")

[node name="Background" parent="." instance=ExtResource("bg")]
layout_mode = 1

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="Page" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Margin/Page"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_type_variation = &"TitleLabel"
text = "Connexion des capteurs"
autowrap_mode = 3

[node name="Hint" type="Label" parent="Margin/Page"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
theme_type_variation = &"MutedLabel"
text = "Allumez votre home trainer et vos capteurs, puis touchez « Connecter »."
autowrap_mode = 3

[node name="Slots" type="HBoxContainer" parent="Margin/Page"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TrainerSlot" type="PanelContainer" parent="Margin/Page/Slots"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Box" type="VBoxContainer" parent="Margin/Page/Slots/TrainerSlot"]
layout_mode = 2

[node name="Kind" type="Label" parent="Margin/Page/Slots/TrainerSlot/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_type_variation = &"MutedLabel"
text = "Home trainer"
autowrap_mode = 3

[node name="Name" type="Label" parent="Margin/Page/Slots/TrainerSlot/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Non connecté"
modulate = Color(0.62, 0.66, 0.72, 1)
clip_text = true
text_overrun_behavior = 3

[node name="Value" type="Label" parent="Margin/Page/Slots/TrainerSlot/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "--"
autowrap_mode = 3

[node name="PowerSlot" type="PanelContainer" parent="Margin/Page/Slots"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Box" type="VBoxContainer" parent="Margin/Page/Slots/PowerSlot"]
layout_mode = 2

[node name="Kind" type="Label" parent="Margin/Page/Slots/PowerSlot/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_type_variation = &"MutedLabel"
text = "Capteur de puissance"
autowrap_mode = 3

[node name="Name" type="Label" parent="Margin/Page/Slots/PowerSlot/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Non connecté"
modulate = Color(0.62, 0.66, 0.72, 1)
clip_text = true
text_overrun_behavior = 3

[node name="Value" type="Label" parent="Margin/Page/Slots/PowerSlot/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "--"
autowrap_mode = 3

[node name="HeartRateSlot" type="PanelContainer" parent="Margin/Page/Slots"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Box" type="VBoxContainer" parent="Margin/Page/Slots/HeartRateSlot"]
layout_mode = 2

[node name="Kind" type="Label" parent="Margin/Page/Slots/HeartRateSlot/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_type_variation = &"MutedLabel"
text = "Ceinture cardio"
autowrap_mode = 3

[node name="Name" type="Label" parent="Margin/Page/Slots/HeartRateSlot/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Non connecté"
modulate = Color(0.62, 0.66, 0.72, 1)
clip_text = true
text_overrun_behavior = 3

[node name="Value" type="Label" parent="Margin/Page/Slots/HeartRateSlot/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "--"
autowrap_mode = 3

[node name="Actions" type="HBoxContainer" parent="Margin/Page"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="ScanButton" type="Button" parent="Margin/Page/Actions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(320, 72)
text = "Rechercher"

[node name="ContinueButton" type="Button" parent="Margin/Page/Actions"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
custom_minimum_size = Vector2(320, 72)
text = "Continuer"
size_flags_horizontal = 3

[node name="RelayModeButton" type="Button" parent="Margin/Page/Actions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(260, 72)
text = "Relais pour PC"
visible = false

[node name="RelayPanel" type="PanelContainer" parent="Margin/Page"]
unique_name_in_owner = true
layout_mode = 2
visible = false

[node name="Box" type="VBoxContainer" parent="Margin/Page/RelayPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Source" type="Label" parent="Margin/Page/RelayPanel/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
theme_type_variation = &"TitleLabel"
text = "Capteurs via : Bluetooth de ce PC"
autowrap_mode = 3

[node name="RelayHint" type="Label" parent="Margin/Page/RelayPanel/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_type_variation = &"MutedLabel"
text = "Pas de Bluetooth sur ce PC ? Ouvrez Velom3d sur le téléphone, branché sur le même Wi-Fi, et touchez « Relais pour PC » : le téléphone apparaît ici."
autowrap_mode = 3

[node name="RelayActions" type="HBoxContainer" parent="Margin/Page/RelayPanel/Box"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="FindPhonesButton" type="Button" parent="Margin/Page/RelayPanel/Box/RelayActions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(260, 52)
text = "Chercher les téléphones"

[node name="RelayAddress" type="LineEdit" parent="Margin/Page/RelayPanel/Box/RelayActions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(220, 52)
placeholder_text = "ou adresse du téléphone (192.168.1.20)"

[node name="RelayConnectButton" type="Button" parent="Margin/Page/RelayPanel/Box/RelayActions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(160, 52)
text = "Se connecter"

[node name="LocalBleButton" type="Button" parent="Margin/Page/RelayPanel/Box/RelayActions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(240, 52)
text = "Bluetooth de ce PC"
visible = false

[node name="Phones" type="HFlowContainer" parent="Margin/Page/RelayPanel/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12

[node name="Status" type="Label" parent="Margin/Page"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
theme_type_variation = &"WarningLabel"
text = ""
autowrap_mode = 3
visible = false

[node name="Scroll" type="ScrollContainer" parent="Margin/Page"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
scroll_deadzone = 12

[node name="List" type="VBoxContainer" parent="Margin/Page/Scroll"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12
size_flags_horizontal = 3

[node name="Empty" type="Label" parent="Margin/Page/Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
theme_type_variation = &"MutedLabel"
text = ""
autowrap_mode = 3
