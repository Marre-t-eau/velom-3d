[gd_scene format=3]

[node name="DeviceRow" type="PanelContainer"]
offset_right = 800.0
offset_bottom = 100.0
mouse_filter = 1

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Text" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Name" type="Label" parent="Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Nom de l'appareil"
autowrap_mode = 3

[node name="Detail" type="Label" parent="Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_type_variation = &"MutedLabel"
text = "Home trainer  ·  signal fort"
autowrap_mode = 3

[node name="ConnectButton" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(220, 72)
mouse_filter = 1
theme_override_font_sizes/font_size = 22
text = "Connecter"
size_flags_vertical = 4
