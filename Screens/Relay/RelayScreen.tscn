[gd_scene format=3]

[ext_resource type="Script" path="res://Screens/Relay/RelayScreen.cs" id="1"]
[ext_resource type="PackedScene" path="res://Screens/Common/Background.tscn" id="bg"]

[node name="RelayScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" parent="." instance=ExtResource("bg")]
layout_mode = 1

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="Page" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Header" type="HBoxContainer" parent="Margin/Page"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/Page/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_type_variation = &"TitleLabel"
text = "Relais pour PC"
autowrap_mode = 3
size_flags_horizontal = 3

[node name="StopButton" type="Button" parent="Margin/Page/Header"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(240, 72)
text = "Arrêter le relais"

[node name="Hint" type="Label" parent="Margin/Page"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
theme_type_variation = &"MutedLabel"
text = "Le téléphone prête son Bluetooth au PC : lancez Velom3d sur le PC, branché sur le même réseau Wi-Fi, puis dans « Connexion des capteurs », choisissez ce téléphone. Le PC recherche et connecte lui-même les capteurs. Gardez l'appli ouverte au premier plan pendant la sortie (l'écran reste allumé)."
autowrap_mode = 3

[node name="StatePanel" type="PanelContainer" parent="Margin/Page"]
unique_name_in_owner = true
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="Margin/Page/StatePanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="State" type="Label" parent="Margin/Page/StatePanel/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 30
theme_type_variation = &"TitleLabel"
text = "En attente du PC…"
autowrap_mode = 3

[node name="Address" type="Label" parent="Margin/Page/StatePanel/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
theme_type_variation = &"MutedLabel"
text = ""
autowrap_mode = 3

[node name="Values" type="Label" parent="Margin/Page/StatePanel/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = ""
autowrap_mode = 3

[node name="Status" type="Label" parent="Margin/Page"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
theme_type_variation = &"WarningLabel"
text = ""
autowrap_mode = 3
visible = false

[node name="Scroll" type="ScrollContainer" parent="Margin/Page"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
scroll_deadzone = 12

[node name="Devices" type="Label" parent="Margin/Page/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = ""
autowrap_mode = 3
