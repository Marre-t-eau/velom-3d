[gd_scene format=3]

[node name="BlockCard" type="PanelContainer"]
offset_right = 1100.0
offset_bottom = 400.0

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Top" type="HBoxContainer" parent="Box"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Box/Top"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Bloc 1"
autowrap_mode = 3
size_flags_horizontal = 3
vertical_alignment = 1

[node name="UpButton" type="Button" parent="Box/Top"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(140, 64)
mouse_filter = 1
theme_override_font_sizes/font_size = 20
text = "Monter"

[node name="DownButton" type="Button" parent="Box/Top"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(160, 64)
mouse_filter = 1
theme_override_font_sizes/font_size = 20
text = "Descendre"

[node name="DuplicateButton" type="Button" parent="Box/Top"]
